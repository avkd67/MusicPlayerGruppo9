<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="300.0" minWidth="500.0" prefHeight="380.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.musicplayergruppo9.controller.InfoBranoController" stylesheets="@../Style.css">
    <children>
        <VBox spacing="18.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
            <children>
                <Label text="Info brano">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <HBox spacing="24.0">
                    <children>
                        <VBox alignment="TOP_CENTER" prefWidth="220.0" spacing="10.0">
                            <children>
                                <ImageView fx:id="imgCopertina" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblTitolo" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <Label fx:id="lblArtista" style="-fx-font-size: 14px; -fx-text-fill: gray;" />
                                <Label fx:id="lblGenere" />
                                <Label fx:id="lblAnno" />
                                <Label fx:id="lblDurata" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <children>
                        <Button styleClass="button-icona" mnemonicParsing="false" onAction="#onAnnulla" prefWidth="100.0" text="Annulla" />
                        <Button styleClass="button-icona" mnemonicParsing="false" onAction="#onModifica" prefWidth="100.0" text="Modifica" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
