<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="630.0" prefWidth="712.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.musicplayergruppo9.controller.BraniPlaylistController" stylesheets="@../Style.css">
    <children>
        <VBox layoutY="204.8" prefHeight="425.0" prefWidth="712.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="205.0">
            <children>
                <Label text="I miei brani">
                    <font>
                        <Font size="28.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
                    </VBox.margin>
                </Label>

                <ListView fx:id="listaBrani" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
      <Button styleClass="button-icona" layoutX="62.0" layoutY="167.0" mnemonicParsing="false" text="play" />
      <Button styleClass="button-icona" layoutX="129.0" layoutY="167.0" mnemonicParsing="false" text="shuffle" />
      <Button styleClass="button-icona" layoutX="203.0" layoutY="167.0" mnemonicParsing="false" text="loop" />
      <ImageView fx:id="imgCopertina" fitHeight="129.0" fitWidth="147.0" layoutX="81.0" layoutY="24.0" pickOnBounds="true" preserveRatio="true" />
      <Button styleClass="button-icona" alignment="CENTER" contentDisplay="CENTER" layoutX="397.0" layoutY="85.0" mnemonicParsing="false" prefHeight="65.0" prefWidth="74.0" text="aggiungi alla coda" />
      <Button styleClass="button-icona" layoutX="482.0" layoutY="89.0" mnemonicParsing="false" onAction="#onModifica" prefHeight="57.0" prefWidth="94.0" text="modifica nome" />
      <Button styleClass="button-icona" layoutX="588.0" layoutY="92.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="74.0" text="cancella playlist" />
      <Label fx:id="LblNomePlaylist" layoutX="251.0" layoutY="67.0" prefHeight="18.0" prefWidth="65.0" text="Label" />
    </children>
</AnchorPane>
