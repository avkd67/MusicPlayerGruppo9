<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="630.0" prefWidth="712.0" stylesheets="@../Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.musicplayergruppo9.controller.BraniPlaylistController">
    <children>
        <VBox layoutY="204.8" prefHeight="425.0" prefWidth="712.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="205.0">
            <children>
                <Label text="I miei brani">
                    <font>
                        <Font size="28.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
                    </VBox.margin>
                </Label>

                <ListView fx:id="listaBrani" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>

        <HBox layoutX="62.0" layoutY="167.0" spacing="15.0">
            <children>
                <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#playPlaylist" style="-fx-padding: 8 15 8 15; -fx-font-size: 14px;" styleClass="button-icona" text=" ▶ ">
                    <tooltip>
                        <Tooltip text="Play" />
                    </tooltip>
                </Button>
                <Button mnemonicParsing="false" style="-fx-padding: 8 15 8 15; -fx-font-size: 14px;" styleClass="button-icona" text="🔀">
                    <tooltip>
                        <Tooltip text="Riproduzione casuale" />
                    </tooltip>
                </Button>
                <Button mnemonicParsing="false" style="-fx-padding: 8 15 8 15; -fx-font-size: 14px;" styleClass="button-icona" text="🔁">
                    <tooltip>
                        <Tooltip text="Ripeti" />
                    </tooltip>
                </Button>
            </children>
        </HBox>

        <ImageView fx:id="imgCopertina" fitHeight="129.0" fitWidth="147.0" layoutX="81.0" layoutY="24.0" pickOnBounds="true" preserveRatio="true" />

        <HBox alignment="CENTER" layoutX="397.0" layoutY="85.0" spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#aggiungiPlaylistAllaCoda" style="-fx-padding: 10 20 10 20; -fx-font-size: 18px;" styleClass="button-icona" text="≡+">
                    <tooltip>
                        <Tooltip text="Aggiungi alla coda" />
                    </tooltip>
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#onModifica" style="-fx-padding: 10 20 10 20; -fx-font-size: 18px;" styleClass="button-icona" text="✏">
                    <tooltip>
                        <Tooltip text="Modifica nome" />
                    </tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#onEliminaPlaylist" style="-fx-padding: 10 20 10 20; -fx-font-size: 18px;" styleClass="button-icona" text="🗑">
                    <tooltip>
                        <Tooltip text="Elimina playlist" />
                    </tooltip>
                </Button>
            </children>
        </HBox>

        <Label fx:id="LblNomePlaylist" layoutX="251.0" layoutY="75.0" maxWidth="130.0" style="-fx-font-weight: bold; -fx-font-size: 18px;" text="Label" wrapText="true" />
        <Button mnemonicParsing="false" onAction="#onUndo" style="-fx-padding: 8 15 8 15; -fx-font-size: 16px;" styleClass="button-icona" text="⟲" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <tooltip>
                <Tooltip text="Annulla ultima azione" />
            </tooltip>
        </Button>
    </children>
</AnchorPane>
