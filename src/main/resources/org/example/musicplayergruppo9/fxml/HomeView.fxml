<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            prefHeight="553.0" prefWidth="836.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.musicplayergruppo9.controller.HomeController" stylesheets="@../Style.css">
  <content>
    <AnchorPane minHeight="0.0" minWidth="0.0">
      <children>
        <VBox AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0"
              spacing="10" style="-fx-padding: 12;">

          <!-- SEZIONE PLAYLIST -->
          <Label text="Playlist" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

          <FlowPane fx:id="playlistsFlowPane"
                    hgap="16" vgap="16"
                    style="-fx-padding: 4;"/>

          <!-- SEZIONE PIÙ ASCOLTATI -->
          <Label text="Più ascoltati" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

          <FlowPane fx:id="piuAscoltatiFlowPane"
                    hgap="16" vgap="16"
                    style="-fx-padding: 4;"/>

        </VBox>
      </children>
    </AnchorPane>
  </content>
</ScrollPane>